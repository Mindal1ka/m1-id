# ════════════════════════════════════════════════════════════════
# M1 ID backend — шаблон прод-конфігу.
# Скопіюйте в backend/.env (файл .env НЕ комітити!) і заповніть.
# Усі змінні читаються з префіксом M1ID_ (pydantic-settings).
# ════════════════════════════════════════════════════════════════

# Дев-режим (dev-ендпоінт /api/accounts/link-token, попередження, Swagger /docs).
# НА ПРОДІ ЗАЛИШИТИ 0.
M1ID_DEBUG=0

# Секрет підписів M1 ID (HMAC, токени прив'язки Telegram). Згенерувати:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Якщо порожньо — ключ створиться в backend/.jwt_key (зробіть його бекап!).
M1ID_SECRET_KEY=

# Ключ шифрування токенів MyStat (AES/Fernet). Якщо порожньо — авто-ключ
# у backend/.token_key. Бекапте: втрата ключа = токени нечитабельні.
# Підійде довільний довгий рядок (деривується у Fernet-ключ).
M1ID_TOKEN_ENC_KEY=

# Строк життя сесії (днів, sliding-продовження). 30 за замовчуванням.
# M1ID_REFRESH_TOKEN_EXPIRE_DAYS=30

# БД. Зараз SQLite; Postgres потім — один рядок:
# M1ID_DB_URL=postgresql+psycopg://user:pass@host/m1id
# M1ID_DB_URL=sqlite:///C:/absolute/path/to/m1id.db

# Перевірка MX-записів домену при реєстрації (0 = вимкнути, якщо DNS
# недоступний із сервера).
M1ID_EMAIL_MX_CHECK=1

# ДЕМО-хук фейкового розкладу для навантажувального тесту. НА ПРОДІ — 0.
M1ID_DEMO_SCHEDULE=0

# Звідки тягнути свіжу OpenAPI-спеку (порожньо = локальний снапшот).
# M1ID_SPEC_URL=http://127.0.0.1:8080/api/system/openapi.json

# ── Маршрут до MyStat API ──────────────────────────────────────────
# Прямий маршрут (дефолт):
#   M1ID_MYSTAT_API_BASE=https://mapi.itstep.org
# ВАЖЛИВО: прод-батник сам питає маршрут при старті й ставить
# M1ID_MYSTAT_API_BASE — змінні оточення сильніші за .env.

# Таймаут запитів до mapi.itstep.org (сек).
# M1ID_SYNC_TIMEOUT_SECONDS=15

# CORS (JSON-масив). Прод-домени вже в дефолті; за потреби:
# M1ID_CORS_ORIGINS=["https://m.mindal1ka.com","https://mapi.mindal1ka.com"]

# ── Telegram-бот ──────────────────────────────────────────────────
# Токен від @BotFather (живе в одному процесі з API, таблиці telegram_*).
# Порожньо = бот вимкнений, сайт працює як раніше.
# M1ID_TELEGRAM_BOT_TOKEN=
# Цикл оновлення даних для сповіщень (сек), запити розмазуються по вікну.
# M1ID_TELEGRAM_POLL_SECONDS=1800

# ── Проксі / Swagger / адміни ─────────────────────────────────────
# Прод стоїть за Cloudflare + Caddy: увімкніть, щоб rate-limit брав справжній
# IP клієнта з CF-Connecting-IP / X-Forwarded-For. Без реального проксі
# НЕ вмикати (клієнт підробить IP).
# M1ID_TRUSTED_PROXY=1
# Кількість довірених хопів у X-Forwarded-For (справа), якщо немає
# CF-Connecting-IP. Caddy напряму від клієнта = 1.
# M1ID_TRUSTED_PROXY_HOPS=1
# Swagger UI (/docs) і /openapi.json: на проді вимкнено; у M1ID_DEBUG=1 увімкнено.
# M1ID_DOCS_ENABLED=0
# user_id адміністраторів через кому (id=1 завжди адмін):
# M1ID_ADMIN_USER_IDS=

# Домен розгортання (CORS, посилання з Telegram-бота). Для дева лишіть як є;
# на проді вкажіть свій, напр. M1ID_DOMAIN=m1.your-domain.com
# M1ID_DOMAIN=m1id.xyz
